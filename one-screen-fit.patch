diff --git a/src/app/globals.css b/src/app/globals.css
index 80242e5..6f6e2eb 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -13,3 +13,55 @@ body {
   background-attachment: fixed;
   font-feature-settings: "cv11", "ss01";
 }
+
+/* ------------------------------------------------------------------ *
+ * One-screen fit (desktop, 3-column layout only: >= 1280px wide).
+ * The dashboard becomes exactly one viewport tall; the main row takes
+ * whatever height is left and spacing scales down with viewport height.
+ * Below 1280px the layout stacks and scrolls normally, as before.
+ * ------------------------------------------------------------------ */
+@media (min-width: 1280px) {
+  .dash-fit {
+    height: 100vh;
+    height: 100dvh;
+    min-height: 640px;
+    padding-top: clamp(6px, 1.3vh, 24px);
+    padding-bottom: clamp(6px, 1.3vh, 24px);
+    row-gap: clamp(6px, 1.5vh, 20px);
+  }
+  .dash-fit h1 { font-size: clamp(22px, 3.3vh, 31px); }
+  .dash-fit .mt-3.flex.flex-col { margin-top: 0; }
+  .dash-fit section { padding: clamp(10px, 2.1vh, 24px); }
+
+  /* main row: fills the remaining height, cards shrink to fit */
+  .dash-main { flex: 1 1 0; min-height: 0; grid-template-rows: minmax(0, 1fr); gap: clamp(8px, 1.5vh, 16px); }
+  .dash-main > div { min-height: 0; }
+  .dash-main .min-h-\[180px\] { min-height: 60px; }
+  .dash-main .mt-3 { margin-top: clamp(4px, 1vh, 12px); }
+  .dash-main .mt-5 { margin-top: clamp(4px, 1.2vh, 20px); }
+  .dash-main .pt-5 { padding-top: clamp(4px, 1.2vh, 20px); }
+  .dash-main .py-2\.5 { padding-top: clamp(4px, 0.9vh, 10px); padding-bottom: clamp(4px, 0.9vh, 10px); }
+  .dash-main .space-y-2\.5 > :not([hidden]) ~ :not([hidden]) { margin-top: clamp(4px, 0.9vh, 10px) !important; }
+  .dash-main svg[aria-label="Wind direction compass"] { width: auto; height: min(172px, 21dvh); aspect-ratio: 1 / 1; }
+
+  /* KPI row */
+  .dash-kpi section { padding-top: clamp(8px, 1.8vh, 20px) !important; padding-bottom: clamp(8px, 1.8vh, 20px) !important; }
+  .dash-kpi .mt-3 { margin-top: clamp(4px, 1vh, 12px); }
+  .dash-kpi .mt-4 { margin-top: clamp(4px, 1.3vh, 16px); }
+
+  /* bottom row */
+  .dash-bottom { gap: clamp(8px, 1.5vh, 16px); }
+  .dash-bottom .mt-3 { margin-top: clamp(2px, 0.8vh, 12px); }
+  .dash-bottom .mt-4 { margin-top: clamp(4px, 1.2vh, 16px); }
+  .dash-bottom .pt-5 { padding-top: clamp(4px, 1.2vh, 20px); }
+  .dash-bottom .py-3:not(:last-child) { padding-top: clamp(3px, 0.8vh, 12px); padding-bottom: clamp(3px, 0.8vh, 12px); }
+  .dash-bottom .py-3:last-child { padding-top: clamp(3px, 0.8vh, 12px); }
+}
+
+/* Short desktop screens (<= 690px tall): slightly smaller large numerals. */
+@media (min-width: 1280px) and (max-height: 690px) {
+  .dash-main .text-\[40px\] { font-size: 30px; }
+  .dash-main .text-\[50px\] { font-size: 38px; }
+  .dash-kpi .text-\[38px\] { font-size: 30px; }
+  .dash-bottom .text-\[36px\] { font-size: 28px; }
+}
