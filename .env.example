# Matrix SP-360 Smart Pole Dashboard — environment variables
#
# These are consumed client-side (NEXT_PUBLIC_*) because the dashboard reads
# sensor_data directly via the Supabase JS client using the PUBLISHABLE/ANON
# key, which is designed to be exposed to the browser and is protected by
# Row Level Security (RLS) policies on the sensor_data table — NOT by secrecy.
#
# NEVER put a service_role / secret key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: polling fallback interval in milliseconds, used if Supabase
# Realtime is unavailable/unreliable. Defaults to 15000 (15s) in code.
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
